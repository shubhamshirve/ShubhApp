# eBill Application Configuration
# Copy this file to .env and fill in your values
# SECURITY WARNING: Never commit the actual .env file with real credentials!

# ===================================================================
# CORE CONFIGURATION (Required in all environments)
# ===================================================================

# Domain/Server Configuration
DOMAIN=localhost                    # Your domain (localhost for dev, domain for prod)
SERVER_IP=                          # Server IP (empty for localhost, set for production)

# ===================================================================
# MONGODB CONFIGURATION (Required)
# ===================================================================

# For Docker environments, use: mongodb://mongodb:27017/saas_db
# For local development, use: mongodb://localhost:27017/saas_db
MONGO_URI=mongodb://mongodb:27017/saas_db
DB_NAME=saas_db

# MongoDB credentials
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-this-mongo-password-in-production

# ===================================================================
# API CONFIGURATION (Required)
# ===================================================================

# CORS Origins (comma-separated, no spaces)
# Development: http://localhost:3000,http://localhost:8000
# Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Frontend backend URL
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
REACT_APP_BACKEND_URL=http://localhost:8000

# ===================================================================
# SECURITY KEYS (Required - Generate strong random values!)
# ===================================================================

# JWT Secret for token signing (min 32 characters, random string)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-this-to-a-strong-random-secret-min-32-chars

# Backup password for database backups
# Generate: python -c "import secrets; print(secrets.token_urlsafe(16))"
BACKUP_PASSWORD=change-this-backup-password

# ===================================================================
# OPTIONAL: PAYMENT CONFIGURATION
# Set these only if using Razorpay. Leave empty if not needed.
# These can also be configured via Admin Settings UI.
# ===================================================================

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ===================================================================
# OPTIONAL: EMAIL CONFIGURATION
# Set these only if you want to send emails. Leave empty if not needed.
# These can also be configured via Admin Settings UI.
#
# Option 1: Using Resend (recommended)
# ===================================================================

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ===================================================================
# Option 2: Using SMTP (leave empty if using Resend)
# ===================================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ===================================================================
# OPTIONAL: WHATSAPP CONFIGURATION
# Set these only if using WhatsApp Business API. Leave empty if not needed.
# These can also be configured via Admin Settings UI.
# ===================================================================

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
