# Ensure shell scripts always have LF line endings
*.sh text eol=lf
docker/* text eol=lf

# Ensure Python files have LF endings
*.py text eol=lf

# Ensure JavaScript/Node files have LF endings  
*.js text eol=lf
*.json text eol=lf

# Docker and config files
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf
Caddyfile text eol=lf
.env text eol=lf
